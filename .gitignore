# ==========================================
# Everyone Can Pay - Git Ignore
# ==========================================

# Node.js dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# PayPal and Gemini API credentials
*.pem
*.key
secrets/

# SQLite database files
backend/data/
*.db
*.db-shm
*.db-wal

# Build output
frontend/dist/
backend/dist/
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Testing and coverage
coverage/
.nyc_output/

# Editor settings
.vscode/
.idea/
*.suo
*.user

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak